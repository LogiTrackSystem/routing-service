DATABASE_URL=postgresql://usuario:password@localhost:5432/routing_db
RABBITMQ_URL=amqp://usuario:password@localhost:5672/
FLEET_SERVICE_URL=http://localhost:8000
SHIPMENT_SERVICE_URL=http://localhost:8001
OSRM_URL=https://router.project-osrm.org
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=
# Tiempos de OSRM (en la nube conviene 2 intentos de 12 s para no pasar el tiempo de espera de Shipment)
OSRM_INTENTOS=3
OSRM_TIMEOUT_S=25

# --- Asignación por cercanía y carga compartida ---
# Tramo en vacío (del lugar donde está el vehículo hasta el origen): reintentos y tiempo de espera de OSRM.
# Si OSRM no responde se estima (línea recta x 1.3) y se marca como "estimada".
OSRM_INTENTOS_REPOSICION=2
OSRM_TIMEOUT_REPOSICION_S=10
# Por debajo de esta distancia en línea recta el vehículo "ya está en el origen" y no hay tramo que simular
UMBRAL_MISMO_LUGAR_KM=2
# Carga compartida: subir un envío al vehículo que ya va por la misma ruta (false = apagarla)
CARGA_COMPARTIDA_ACTIVA=true
# Una parada cuenta como "sobre la ruta" (sin desvío) si está a menos de estos km de la carretera
PARADA_MAX_DESVIO_KM=5
# El vehículo debe estar al menos estos km antes del punto de recogida para poder subir la carga
MARGEN_RECOGIDA_KM=15
# Tramo mínimo (km) que debe recorrer la carga compartida
TRAMO_MINIMO_COMPARTIDO_KM=5

# Espera máxima (ms) por un candado de fila antes de fallar; 0 = sin límite
DB_LOCK_TIMEOUT_MS=15000

# Máximo de rutas en viaje que se evalúan como posibles anfitrionas de una carga compartida
MAX_ANFITRIONES_EVALUADOS=500

# Reintentos (sin bloquear) cuando un aviso llega mientras otra tarea tiene tomada la ruta
ESPERA_RUTA_OCUPADA_S=0.5
INTENTOS_RUTA_OCUPADA=120
