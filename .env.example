DATABASE_URL=postgresql://usuario:password@localhost:5432/routing_db
RABBITMQ_URL=amqp://usuario:password@localhost:5672/
FLEET_SERVICE_URL=http://localhost:8000
SHIPMENT_SERVICE_URL=http://localhost:8001
OSRM_URL=https://router.project-osrm.org
# Clave compartida con el gateway y los demás servicios (producción). Vacía = sin restricción (local).
INTERNAL_API_KEY=
# Tiempos de OSRM (en la nube conviene 2 intentos de 12 s para no pasar el tiempo de espera de Shipment)
OSRM_INTENTOS=3
OSRM_TIMEOUT_S=25
